<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Source réelle : capteur de la station météo -->
    <bean id="dao" class="dao.DaoImpl"></bean>

    <!-- Source simulée : mesure fictive de développement -->
    <bean id="dao2" class="dao.DaoImpl2"></bean>

    <!-- Couche métier : Spring appelle setDao() avec le bean choisi dans ref -->
    <bean id="metier" class="metier.MetierImpl">
        <property name="dao" ref="dao2"></property>
    </bean>

</beans>
